# credentials - never commit
.env
.env.*
!.env.example
*.pem
*.key

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# runtime artefacts
data/*.lock
logs/
*.sqlite
*.db

# evidence is committed deliberately; raw scratch is not
tests/evidence/_scratch/

# editors
.vscode/
.idea/
.DS_Store

# [G4 5.1] binary wheels are a build artifact and live OUTSIDE the repo
# (tools/build_wheelhouse.py default); this backstop stops anyone
# sneaking a wheel INTO the tree where the manifest would go stale.
*.whl
.wheelhouse/
